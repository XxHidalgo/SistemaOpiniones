{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/etl-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "ConnectionStrings": {
    "OrigenResenasWeb": "Server=localhost;Database=SistemaOpiniones_Origen;Integrated Security=True;Encrypt=True;TrustServerCertificate=True",
    "Analitica": "Server=localhost;Database=SistemaOpiniones_Analitica;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },

  "Etl": {
    "RunOnceAndExit": true,
    "IntervalMinutes": 60,
    "MaxDegreeOfParallelism": 0,

    "Staging": {
      "Mode": "SqlServer",
      "Directory": "output/staging",
      "ConnectionStringName": "Analitica",
      "TableName": "dbo.Stg_Opinion",
      "BatchSize": 1000
    },

    "Sources": {
      "Csv": {
        "Enabled": true,
        "Name": "EncuestasInternas",
        "Path": "Data/surveys_part1.csv",
        "Delimiter": ",",
        "Culture": "es-DO"
      },

      "Database": {
        "Enabled": true,
        "Name": "ResenasWeb",
        "ConnectionStringName": "OrigenResenasWeb",
        "Query": "SELECT IdReview AS ExternalId, IdCliente AS ClienteRef, IdProducto AS ProductoRef, 'Web' AS FuenteRef, Fecha, Comentario, Rating AS Puntaje, NULL AS Clasificacion FROM dbo.WebReview;",
        "CommandTimeoutSeconds": 60
      },

      "Api": {
        "Enabled": true,
        "Name": "ComentariosRedesSociales",
        "BaseUrl": "https://jsonplaceholder.typicode.com/",
        "Endpoint": "comments",
        "PageParamName": "_page",
        "PageSizeParamName": "_limit",
        "PageSize": 100,
        "MaxPages": 10,
        "TimeoutSeconds": 30,
        "RetryCount": 3,
        "ApiKeyHeaderName": "X-Api-Key",
        "ResultsProperty": "",
        "FieldMap": {
          "ExternalId": "id",
          "ClienteRef": "email",
          "ProductoRef": "postId",
          "Comentario": "body",
          "FuenteRef": "",
          "Fecha": "",
          "Puntaje": "",
          "Clasificacion": ""
        }
      }
    }
  }
}
